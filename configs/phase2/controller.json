{
  "experiment_name": "phase2_binary_sufficiency_controller_v1",
  "seed": 42,
  "phase1_frozen_commit": "702bfc3",
  "chunk_variant": null,
  "default_evidence_mode": "cumulative",
  "include_stage_metadata_in_query_evidence": true,
  "evidence_modes": ["raw", "cumulative"],
  "controller_ladder": ["dense@5", "hybrid@10", "rerank@20"],
  "task": {
    "primary": "binary_stop_continue",
    "label_names": ["continue", "stop"],
    "stop_definition": "complete_evidence_coverage == 1",
    "diagnostic_label_names": ["insufficient", "partial", "sufficient"]
  },
  "backbone": {
    "name": "BAAI/bge-reranker-base",
    "max_length": 512
  },
  "baselines": [
    {"id": "A", "name": "query_only", "input": "question"},
    {"id": "B", "name": "query_stage", "input": "question_stage_k_method"},
    {"id": "C", "name": "query_stage_stats", "input": "question_stage_k_method_retrieval_statistics"},
    {"id": "D", "name": "evidence_only", "input": "evidence"},
    {"id": "E", "name": "query_evidence", "input": "question_evidence"}
  ],
  "representations": {
    "concat_truncate": {
      "type": "concat",
      "document_separator": " [DOC] ",
      "truncation": "only_second_preserve_question"
    },
    "uniform_packing": {
      "type": "packed_concat",
      "minimum_chunk_tokens": 12,
      "allocation": "uniform",
      "preserve_titles": true,
      "preserve_chunk_boundaries": true
    },
    "score_aware_packing": {
      "type": "packed_concat",
      "minimum_chunk_tokens": 12,
      "allocation": "rank_score_weighted",
      "preserve_titles": true,
      "preserve_chunk_boundaries": true
    },
    "hierarchical_mean": {"type": "hierarchical", "aggregation": "mean"},
    "hierarchical_max": {"type": "hierarchical", "aggregation": "max"},
    "hierarchical_mean_max": {"type": "hierarchical", "aggregation": "mean_max"}
  },
  "training": {
    "loss": "unweighted_cross_entropy",
    "optimizer": "AdamW",
    "epochs": 4,
    "batch_size": 16,
    "eval_batch_size": 64,
    "num_workers": 4,
    "hierarchical_batch_size": 2,
    "hierarchical_gradient_accumulation_steps": 8,
    "hierarchical_pair_max_length": 256,
    "hierarchical_encoder_chunk_batch_size": 16,
    "hierarchical_freeze_encoder": true,
    "gradient_accumulation_steps": 1,
    "cublas_workspace_config": ":4096:8",
    "learning_rate": 2e-5,
    "weight_decay": 0.0,
    "warmup_ratio": 0.05,
    "selection_metric": "stop_f1",
    "selection_split": "dev",
    "threshold": 0.5,
    "threshold_grid": {"start": 0.05, "stop": 0.95, "step": 0.01},
    "threshold_selection_split": "dev",
    "test_is_evaluation_only": true
  },
  "counterfactuals": [
    "evidence_order_shuffle",
    "cross_question_evidence_swap",
    "stage_metadata_removal",
    "title_only_evidence"
  ],
  "analysis_buckets": {
    "evidence_tokens": ["<=512", "513-1024", "1025-2048", ">2048"],
    "gold_supporting_facts": ["2", "3", "4+"]
  }
}
