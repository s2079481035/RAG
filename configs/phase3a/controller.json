{
  "experiment_name": "phase3a_hard_partial_controller_v1",
  "phase2_frozen_branch": "research/sufficiency-phase2",
  "seeds": [42, 123, 2026],
  "variant": "sentence_256",
  "backbone": {
    "name": "BAAI/bge-reranker-base",
    "max_length": 512
  },
  "input": {
    "evidence_mode": "cumulative",
    "include_stage_metadata_in_query_evidence": true,
    "minimum_chunk_tokens": 12
  },
  "training": {
    "optimizer": "AdamW",
    "epochs": 4,
    "batch_size": 16,
    "eval_batch_size": 64,
    "num_workers": 4,
    "learning_rate": 2e-5,
    "weight_decay": 0.0,
    "warmup_ratio": 0.05,
    "selection_metric": "stop_f1",
    "selection_split": "dev",
    "fixed_threshold": 0.5,
    "threshold_grid": {"start": 0.05, "stop": 0.95, "step": 0.01},
    "threshold_selection_split": "dev",
    "test_is_evaluation_only": true,
    "cublas_workspace_config": ":4096:8"
  },
  "coverage_auxiliary": {
    "loss": "smooth_l1",
    "candidate_lambdas": [0.1, 0.3, 1.0],
    "selection_seed": 42,
    "selection_split": "dev",
    "selection_rule": [
      "maximize_macro_f1",
      "minimize_hard_partial_false_stop_rate",
      "maximize_auroc",
      "minimize_lambda"
    ]
  },
  "sampling": {
    "natural": {"replacement": false},
    "balanced_stop_continue": {
      "replacement": true,
      "target_group_mass": {"stop": 0.5, "continue": 0.5}
    },
    "hard_partial_aware": {
      "replacement": true,
      "target_group_mass": {
        "stop": 0.5,
        "continue_non_hard": 0.25,
        "continue_hard_partial": 0.25
      }
    }
  },
  "hard_partial": {
    "easy_continue": "coverage == 0",
    "medium_partial": "0 < coverage < 0.5",
    "hard_partial": "0.5 <= coverage < 1.0"
  },
  "bootstrap": {
    "unit": "question_id",
    "replicates": 2000,
    "seed": 42,
    "confidence_level": 0.95
  },
  "final_controller_selection": {
    "selection_split": "dev",
    "required_seeds": [42, 123, 2026],
    "candidate_groups": [
      "score_aware_baseline",
      "score_aware_coverage_auxiliary",
      "score_aware_hard_partial_sampling",
      "score_aware_coverage_auxiliary_hard_partial_sampling"
    ],
    "selection_rule": [
      "maximize_mean_macro_f1",
      "minimize_mean_hard_partial_false_stop_rate",
      "maximize_mean_auroc",
      "minimize_mean_unnecessary_escalation_rate",
      "prefer_simpler_model"
    ]
  }
}
