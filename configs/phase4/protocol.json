{
  "experiment_name": "phase4_2wiki_credibility_extension_v1",
  "phase": 4,
  "phase3b_freeze": {
    "tag": "phase3b_final",
    "commit": "1ed762c",
    "final_controller_selection": "results/phase3/final_controller_selection.json",
    "risk_policy": "results/phase3b/test_gate.json",
    "generation_config": "configs/phase3a/generation.json"
  },
  "dataset": {
    "name": "2WikiMultiHopQA",
    "official_repository": "https://github.com/Alab-NII/2wikimultihop",
    "official_train": "data/2wiki/source/train.json",
    "official_dev": "data/2wiki/source/dev.json",
    "official_test_is_unlabeled_and_unused": true,
    "official_dev_role": "heldout",
    "valid_splits": [
      "train_core",
      "dev_calibration",
      "dev_policy",
      "heldout"
    ],
    "evaluation_split": "heldout",
    "internal_split": {
      "source": "official_train",
      "unit": "question_id",
      "seed": 42,
      "dev_calibration_questions": 2000,
      "dev_policy_questions": 2000,
      "remainder": "train_core"
    }
  },
  "corpus_scope": {
    "name": "shared benchmark-context corpus",
    "sources": [
      "official_train.context",
      "official_dev.context"
    ],
    "deduplication": "exact_document_title_plus_exact_joined_text",
    "not_full_wikipedia": true
  },
  "chunking": {
    "tokenizer": "BAAI/bge-large-en-v1.5",
    "include_special_tokens_in_budget": false,
    "sentence_separator": " ",
    "overlap_sentences": 0,
    "variants": [
      {
        "name": "sentence_256",
        "target_tokens": 256
      }
    ],
    "default_candidate": "sentence_256"
  },
  "retrieval": {
    "dense_model": "BAAI/bge-large-en-v1.5",
    "document_text": "title_and_chunk_text",
    "document_text_template": "[TITLE] {document_title} [TEXT] {chunk_text}",
    "query_instruction": null,
    "dense_normalize_embeddings": true,
    "faiss_index": "IndexFlatIP",
    "bm25_implementation": "rank_bm25.BM25Okapi",
    "bm25_parameters": "library_defaults",
    "rrf_k": 60,
    "dense_candidate_k": 200,
    "bm25_candidate_k": 200,
    "hybrid_candidate_k": 20,
    "reranker_model": "BAAI/bge-reranker-v2-m3",
    "reranker_max_length": 512,
    "saved_ranking_depth": 20
  },
  "retrieval_evaluation": {
    "methods": [
      "dense",
      "bm25",
      "hybrid",
      "rerank"
    ],
    "ks": [
      5,
      10,
      20
    ],
    "selection_variants": [
      "sentence_256"
    ],
    "selected_variant_after_dev": "sentence_256",
    "selection_status": "transferred_without_2wiki_sweep"
  },
  "controller_ladder": [
    "dense@5",
    "hybrid@10",
    "rerank@20"
  ],
  "controller": {
    "backbone": "BAAI/bge-reranker-base",
    "max_length": 512,
    "representation": "score_aware_packing",
    "evidence_mode": "cumulative",
    "minimum_chunk_tokens": 12,
    "coverage_auxiliary": true,
    "coverage_lambda": 0.1,
    "sampling": "natural",
    "seeds": [
      42,
      123,
      2026
    ],
    "hotpotqa_checkpoint": "experiments/phase3a/lambda_dev/lambda_0.1_seed42/best.pt",
    "hotpotqa_temperature": 1.0732333511122047,
    "hotpotqa_primary_threshold": 0.93,
    "risk_targets": [
      0.2,
      0.1,
      0.05
    ],
    "bootstrap_replicates": 2000
  },
  "in_domain_policy": {
    "operational_seed": 42,
    "operational_seed_rule": "fixed_before_dev_policy_metrics_not_selected_by_performance",
    "calibration": {
      "method": "temperature",
      "fit_split": "dev_calibration",
      "temperature_log_bounds": [
        -5.0,
        5.0
      ],
      "optimizer_iterations": 200,
      "probability_epsilon": 1e-7,
      "ece_bins": 15,
      "high_confidence_stop_probability": 0.9
    },
    "decision_stages": [
      "dense@5",
      "hybrid@10"
    ],
    "forced_final_stage": "rerank@20",
    "threshold_grid": {
      "start": 0.0,
      "stop": 1.0,
      "step": 0.01,
      "include_always_final_endpoint": true
    },
    "risk_targets": [
      0.2,
      0.1,
      0.05
    ],
    "risk_metric": "false_stop_rate_over_true_continue_decisions_reached_by_the_sequential_policy",
    "selection_cost": "average_retrieved_chunks",
    "bootstrap": {
      "unit": "question_id",
      "replicates": 2000,
      "seed": 42,
      "confidence_level": 0.95
    },
    "primary_report_policy": {
      "calibration": "temperature",
      "selection": "conservative",
      "risk_target": 0.1
    },
    "frozen_dev_gate": {
      "classification_operating_point": {
        "probability": "raw",
        "threshold": 0.7900000000000001,
        "purpose": "critic_discrimination"
      },
      "temperature": 1.3473834252368755,
      "risk_controlled_operating_point": {
        "policy": "temperature_conservative_risk_10",
        "threshold": 0.01,
        "risk_target": 0.1,
        "purpose": "retrieval_efficiency_under_dev_risk_budget"
      }
    },
    "heldout_tuning_forbidden": true
  },
  "score_threshold": {
    "feature": "top1_normalized_retrieval_score",
    "normalization": "within_stage_min_max_from_dev_policy",
    "threshold_selection_split": "dev_policy",
    "threshold_grid": {
      "start": 0.0,
      "stop": 1.0,
      "step": 0.01
    },
    "test_tuning_forbidden": true
  },
  "llm_judge": {
    "model": "Qwen/Qwen2.5-7B-Instruct",
    "model_source": "phase3a_frozen_generator",
    "prompt_path": "configs/phase4/llm_judge_prompt.txt",
    "representations": [
      "judge_512",
      "judge_full"
    ],
    "actionable_stages": [
      "dense@5",
      "hybrid@10"
    ],
    "judge_512": {
      "packing_tokenizer": "BAAI/bge-large-en-v1.5",
      "representation": "score_aware_packing",
      "critic_pair_max_length": 512,
      "minimum_chunk_tokens": 12,
      "include_stage_metadata_in_packing_budget": true
    },
    "judge_full": {
      "packing": "retrieval_order_full_chunks_then_final_prefix_truncation",
      "max_input_tokens": 4096
    },
    "decoding": {
      "do_sample": false,
      "temperature": null,
      "num_beams": 1
    },
    "max_new_tokens": 8,
    "latency_warmup_states": 5,
    "controller_probability_replay_tolerance": 0.0001,
    "allowed_labels": [
      "SUFFICIENT",
      "INSUFFICIENT"
    ],
    "invalid_output_action": "continue",
    "prompt_check_split": "dev_calibration",
    "prompt_check_questions": 100,
    "minimum_parse_rate": 0.99,
    "formal_dev_split": "dev_policy",
    "label_probability_available": false,
    "auroc_reported": false,
    "heldout_prompt_tuning_forbidden": true
  },
  "external_baselines": {
    "adaptive_rag": {
      "official_repository": "https://github.com/starsuzi/Adaptive-RAG",
      "paper": "https://aclanthology.org/2024.naacl-long.389/",
      "status": "adapted_protocol_only",
      "formal_name": "Adaptive-RAG-style Query Complexity Router",
      "strict_official_reproduction": false,
      "router_input": "question_only",
      "route_mapping": {
        "light": "dense@5",
        "medium": "hybrid@10",
        "heavy": "rerank@20"
      },
      "training_label": "earliest_frozen_stage_with_complete_gold_supporting_fact_coverage_else_heavy",
      "training_split": "train_core",
      "development_splits": [
        "dev_calibration",
        "dev_policy"
      ],
      "heldout_tuning_forbidden": true,
      "execution_status": "deferred_unless_low_cost"
    },
    "s2g_rag": {
      "official_repository": "https://github.com/nianaaa/S2G-RAG",
      "paper": "https://aclanthology.org/2026.acl-long.1185/",
      "working_day_limit": 2,
      "status": "not_started"
    }
  },
  "outputs": {
    "data_dir": "data/2wiki",
    "result_dir": "results/phase4/2wiki",
    "dataset_audit": "docs/phase4/2wiki_dataset_audit.md",
    "corpus_audit": "docs/phase4/2wiki_corpus_audit.md",
    "trajectory_audit": "docs/phase4/2wiki_trajectory_audit.md"
  }
}
