{
  "experiment_name": "phase4_2wiki_adaptive_rag_style_router_v1",
  "phase": 4,
  "formal_name": "Adaptive-RAG-style Query-Complexity Router",
  "official_reproduction": false,
  "stage_mapping": "configs/phase4/adaptive_rag_stage_mapping.yaml",
  "route_names": ["light", "medium", "heavy"],
  "stage_names": ["dense@5", "hybrid@10", "rerank@20"],
  "inference_features": ["question"],
  "forbidden_inference_features": [
    "answer",
    "supporting_facts",
    "gold_supporting_facts",
    "retrieved_chunks",
    "retrieval_scores",
    "complete_coverage",
    "final_stage_evidence",
    "recoverability",
    "critic_probability"
  ],
  "label_construction": "earliest_frozen_cumulative_stage_with_complete_gold_supporting_fact_coverage_else_heavy",
  "data": {
    "source_dir": "data/2wiki/controller/sentence_256",
    "router_dir": "data/2wiki/adaptive_rag",
    "train_split": "train_core",
    "selection_split": "dev_calibration",
    "evaluation_split": "dev_policy",
    "heldout_split": "heldout"
  },
  "model": {
    "backbone": "BAAI/bge-reranker-base",
    "max_length": 512,
    "num_labels": 3
  },
  "training": {
    "seeds": [42, 123, 2026],
    "operational_seed": 42,
    "optimizer": "AdamW",
    "epochs": 4,
    "batch_size": 16,
    "eval_batch_size": 64,
    "num_workers": 4,
    "learning_rate": 0.00002,
    "weight_decay": 0.0,
    "warmup_ratio": 0.05,
    "selection_metric": "macro_f1",
    "sampling": "natural",
    "prediction_rule": "three_class_argmax",
    "cublas_workspace_config": ":4096:8"
  },
  "output": {
    "experiment_dir": "experiments/phase4/2wiki/adaptive_rag_router",
    "result_dir": "results/phase4/2wiki/adaptive_rag"
  },
  "heldout_tuning_forbidden": true
}
